generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String?
  documentId   String?  @unique
  documentUrl  String?
  role         Role     @default(TOURIST)
  createdAt    DateTime @default(now())

  comercios    Comercio[]
  adminProfile Admin?
  reviews      Review[]

  @@index([email])
  @@index([documentId])
}

enum Role {
  TOURIST
  COMERCIANTE
  ADMIN
  SUPERADMIN
}

model Comercio {
  id           Int       @id @default(autoincrement())
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id])
  name         String
  description  String
  category     Category
  address      String?
  lat          Float?
  lng          Float?
  legalDocUrl  String?
  imageUrl     String?
  logoUrl      String?
  brandColor   String?   @default("#16a34a")
  tags         String[]  @default([])
  status       Status    @default(PENDING)
  verifiedById Int?
  verifiedBy   Admin?    @relation(fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  services      Service[]
  reviews       Review[]
  gallery       GalleryImage[]
  pendingUpdate Json?

  @@index([name])
  @@index([category])
  @@index([status])
}

enum Category {
  GASTRONOMIA
  HOSPEDAJE
  OPERADOR_TURISTICO
  COMERCIO_LOCAL
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Service {
  id          Int      @id @default(autoincrement())
  comercioId  Int
  comercio    Comercio @relation(fields: [comercioId], references: [id])
  title       String
  description String
  price       Float?
  imageUrl    String?
}

model GalleryImage {
  id         Int      @id @default(autoincrement())
  comercioId Int
  comercio   Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  imageUrl   String
  createdAt  DateTime @default(now())
}

model Admin {
  id                Int        @id @default(autoincrement())
  userId            Int        @unique
  user              User       @relation(fields: [userId], references: [id])
  department        String
  approvedComercios Comercio[]
}

model Review {
  id               Int      @id @default(autoincrement())
  rating           Int
  comment          String
  touristName      String?
  touristEmail     String?
  touristPhone     String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  comercioId       Int
  comercio         Comercio @relation(fields: [comercioId], references: [id])
  userId           Int?
  user             User?    @relation(fields: [userId], references: [id])
}

// ==========================================
// CONFIGURACIÓN GLOBAL DE LA PLATAFORMA
// ==========================================
model SiteSettings {
  id             Int      @id @default(1)
  carouselImages Json     @default("[]")
  aboutImageUrl  String? // <-- NUEVO: Imagen para "¿Qué Ofrecemos?"
  facebookUrl    String?
  instagramUrl   String? // <-- NUEVO: Enlace de Instagram
  updatedAt      DateTime @updatedAt
}

// ==========================================
// NUEVO: SISTEMA DE EVENTOS Y CALENDARIO
// ==========================================
model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime // Fecha programada del evento
  imageUrl    String? // Foto del evento o afiche
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING o RESOLVED
  createdAt DateTime @default(now())
}
